<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vendored from farosch/DgvFilterPopup (CPOL 1.02). Retargeted to net8 for the
       varManager modernization. Original authors: Vincenzo Rossi, Faryan Rezagholi.
       SDK default globbing picks up all .cs/.resx; resource names follow the
       DependentUpon filename convention (resx next to same-named .cs). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DgvFilterPopup</RootNamespace>
    <AssemblyName>DgvFilterPopup</AssemblyName>
    <Authors>Vincenzo Rossi, Faryan Rezagholi</Authors>
    <Copyright>2009-2021</Copyright>
    <Version>1.3.1</Version>
  </PropertyGroup>

</Project>
