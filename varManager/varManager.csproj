<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>varManager</RootNamespace>
    <AssemblyName>varManager</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>VarManager.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <!-- Render like the original .NET Framework build (no DPI awareness) so the fixed-size
         WinForms layouts/buttons are not re-scaled and clipped by .NET 8's default DPI mode. -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <!-- VaM script templates: copied to output, NOT compiled into the app. -->
  <ItemGroup>
    <Compile Remove="Custom\**\*.cs" />
    <Content Include="Custom\Scripts\loadscene.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Custom\Scripts\MorphMerger.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Runtime asset shipped next to the exe. -->
  <ItemGroup>
    <Content Include="vam.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- SQLite schema embedded; single source of truth lives in migration\schema.sql. -->
  <ItemGroup>
    <EmbeddedResource Include="..\migration\schema.sql">
      <Link>schema.sql</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.3.3" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="System.Data.OleDb" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DragNDrop\DragNDrop.csproj" />
    <ProjectReference Include="..\DgvFilterPopup\DgvFilterPopup.csproj" />
  </ItemGroup>

</Project>
