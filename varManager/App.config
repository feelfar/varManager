<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System.Configuration.ConfigurationManager">
      <section name="varManager.Properties.Settings" type="System.Configuration.ClientSettingsSection, System.Configuration.ConfigurationManager" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
    </sectionGroup>
  </configSections>
  <userSettings>
    <varManager.Properties.Settings>
      <setting name="varspath" serializeAs="String">
        <value>d:\vars</value>
      </setting>
      <setting name="vampath" serializeAs="String">
        <value>d:\virt_a_mate</value>
      </setting>
      <setting name="presetMorphs" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="presetHair" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="presetClothing" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="presetSkin" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="presetBreast" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="presetGlute" serializeAs="String">
        <value>False</value>
      </setting>
    </varManager.Properties.Settings>
  </userSettings>
</configuration>
